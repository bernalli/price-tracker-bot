msgid "Open the main menu with /start and find Help under Status & info."
msgstr "Open the main menu with /start and find Help under Status & info."

#: src/price_tracker/release_notes.py:43
msgid "Automatic suspension notices no longer repeat during overlapping checks."
msgstr "Automatic suspension notices no longer repeat during overlapping checks."

#: src/price_tracker/release_notes.py:46
msgid "Reach every command through buttons in the main menu."
msgstr "Reach every command through buttons in the main menu."

#: src/price_tracker/release_notes.py:47
msgid "Set quiet hours, time zone and notification limits with guided prompts."
msgstr "Set quiet hours, time zone and notification limits with guided prompts."

#: src/price_tracker/release_notes.py:48
msgid "Manage one product's notifications without changing your other settings."
msgstr "Manage one product's notifications without changing your other settings."

#: src/price_tracker/release_notes.py:50
msgid "Get just one back-in-stock alert when a sold-out product returns."
