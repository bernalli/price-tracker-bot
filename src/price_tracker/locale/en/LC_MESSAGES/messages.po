#: src/price_tracker/release_notes.py:37
msgid "Filter sold-out products and see availability on each card."
msgstr "Filter sold-out products and see availability on each card."

#: src/price_tracker/release_notes.py:38
msgid "Product cards stay in place after actions, with a short confirmation."
msgstr "Product cards stay in place after actions, with a short confirmation."

#: src/price_tracker/release_notes.py:41
msgid "Reach everyday actions from a simpler Telegram command menu."
msgstr "Reach everyday actions from a simpler Telegram command menu."

