#: src/price_tracker/bot/flow_rendering.py:95
msgid "That link is not allowed."
msgstr "Questo link non è consentito."

#: src/price_tracker/bot/flow_rendering.py:99
msgid "Use whole minutes, e.g. 30."
msgstr "Usa minuti interi, per esempio 30."

